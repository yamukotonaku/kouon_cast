# Google AI (Gemini) API キー
# https://aistudio.google.com/apikey で取得
GEMINI_API_KEY=your_gemini_api_key_here

# オプション: Podcast メタデータ（feed.xml 用）
# PODCAST_TITLE=仏教説話ポッドキャスト
# PODCAST_DESCRIPTION=AIが生成する仏教説話を毎日お届けします
# PODCAST_WEBSITE=https://example.com
# PODCAST_BASE_URL=https://example.com/podcast  # 音声ファイルの公開URLベース（未設定時は file:// で出力）
# PODCAST_IMAGE_URL=https://example.com/podcast/artwork.png  # アートワーク画像URL（推奨 1400x1400 px、未設定時は出力しない）
